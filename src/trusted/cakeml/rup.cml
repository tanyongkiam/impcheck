fun get_byte arr i = Word8.toInt (Word8Array.sub arr i);

(* Little-endian: read 8 bytes as u64 starting at index i *)
fun get_u64 arr i =
  get_byte arr i +
  get_byte arr (i+1) * 256 +
  get_byte arr (i+2) * 65536 +
  get_byte arr (i+3) * 16777216 +
  get_byte arr (i+4) * 4294967296 +
  get_byte arr (i+5) * 1099511627776 +
  get_byte arr (i+6) * 281474976710656 +
  get_byte arr (i+7) * 72057594037927936;

(* Little-endian: read 4 bytes as signed int starting at index i *)
fun get_int arr i =
  let
    val raw = get_byte arr i +
              get_byte arr (i+1) * 256 +
              get_byte arr (i+2) * 65536 +
              get_byte arr (i+3) * 16777216
  in
    if get_byte arr (i+3) >= 128
    then raw - 4294967296
    else raw
  end;

fun int_to_le i =
  String.implode [
    Char.chr (i mod 256),
    Char.chr ((i div 256) mod 256),
    Char.chr ((i div 65536) mod 256),
    Char.chr ((i div 16777216) mod 256)
  ];

fun int_to_4le b i =
  String.implode [
    Char.chr (if b then 1 else 0),
    Char.chr (i mod 256),
    Char.chr ((i div 256) mod 256),
    Char.chr ((i div 65536) mod 256),
    Char.chr ((i div 16777216) mod 256)
  ];

(* get_clause returns (clause_arr, literals)
   clause_arr is passed through and possibly resized for reuse *)
fun get_clause clause_arr trusted len =
  let
    val needed = len * 4
    val arr = if Word8Array.length clause_arr < needed
              then Word8Array.array needed (Word8.fromInt 0)
              else clause_arr
    val hdr = int_to_4le trusted len
    val _ = #(clause) hdr arr
    fun read_int i = get_int arr (i * 4)
    fun read_ints i = if i >= len then [] else read_int i :: read_ints (i + 1)
  in
    (arr, read_ints 0)
  end;

fun get_hints len =
  let
    val arr = Word8Array.array (len * 8) (Word8.fromInt 0)
    val _ = #(hints) (int_to_le len) arr
    fun read_val i = get_u64 arr (i * 8)
    fun read_vals i = if i >= len then [] else read_val i :: read_vals (i + 1)
  in
    read_vals 0
  end;

fun do_callback step_arr =
  let
    val _ = #(callback) "1" step_arr
  in
    ()
  end

fun loop step_arr clause_arr =
let
  val step = #(step) "" step_arr
  val c = Char.fromByte (Word8Array.sub step_arr 0)
in
  case c of
    #"a" => (* TRUSTED_CHK_CLS_PRODUCE *)
      let
        val id = get_u64 step_arr 1
        val nb_lits = get_int step_arr 9
        val nb_hints = get_int step_arr 13
        val _ = print ("add ID: " ^ Int.toString id ^"\n")
        val _ = print ("num lits: " ^ Int.toString nb_lits^"\n")
        val (clause_arr, cl) = get_clause clause_arr False nb_lits
        val _ = print ("Literals: " ^ String.concatWith " " (List.map Int.toString cl) ^ "\n")
        val _ = print ("num hints: " ^ Int.toString nb_hints^"\n")
        val hints = get_hints nb_hints
        val _ = print ("Hints: " ^ String.concatWith " " (List.map Int.toString hints) ^ "\n")
      in
        do_callback step_arr;
        loop step_arr clause_arr
      end
  | #"i" => (* TRUSTED_CHK_CLS_IMPORT *)
      let
        val id = get_u64 step_arr 1
        val nb_lits = get_int step_arr 9
        val (clause_arr, cl) = get_clause clause_arr True nb_lits
        val _ = print ("IMPORT ID: " ^ Int.toString id ^"\n")
        val _ = print ("num lits: " ^ Int.toString nb_lits ^"\n")
        val _ = print ("Literals: " ^ String.concatWith " " (List.map Int.toString cl) ^ "\n")
      in
        do_callback step_arr;
        loop step_arr clause_arr
      end
  | #"d" => (* TRUSTED_CHK_CLS_DELETE *)
      let
        val nb_hints = get_int step_arr 1
        val _ = print ("DEL HINTS: " ^ Int.toString nb_hints ^"\n")
        val hints = get_hints nb_hints
        val _ = print ("Hints: " ^ String.concatWith " " (List.map Int.toString hints) ^ "\n")
      in
        do_callback step_arr;
        loop step_arr clause_arr
      end
  | #"V" => (* TRUSTED_CHK_VALIDATE_UNSAT: void *)
      let
        val _ = print "VALIDATE_UNSAT\n"
      in
        do_callback step_arr;
        loop step_arr clause_arr
      end
  | #"T" => (* TRUSTED_CHK_TERMINATE: void *)
      (do_callback step_arr;
      print "TERMINATE\n")
  | _ =>
      print ("UNKNOWN: " ^ Int.toString (get_byte step_arr 0) ^ "\n")
end

val _ = loop (Word8Array.array 17 (Word8.fromInt 0))
             (Word8Array.array 0 (Word8.fromInt 0));
